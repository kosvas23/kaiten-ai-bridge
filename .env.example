# Runtime
BRIDGE_ENVIRONMENT=production
BRIDGE_LOG_LEVEL=INFO
BRIDGE_LOG_DIR=/var/log/kaiten-ai-bridge
BRIDGE_DATABASE_PATH=/var/lib/kaiten-ai-bridge/bridge.sqlite3
BRIDGE_TEMP_DIR=/var/lib/kaiten-ai-bridge/tmp

# Inbound HTTP server. Keep loopback when nginx and the corporate AI run on this host.
BRIDGE_BIND_HOST=127.0.0.1
BRIDGE_BIND_PORT=8080
BRIDGE_WEBHOOK_PATH=/webhooks/kaiten
BRIDGE_CALLBACK_PATH=/callbacks/corporate-ai
BRIDGE_HEALTH_PATH=/health
BRIDGE_CALLBACK_BEARER_TOKEN=<replace-with-a-long-random-callback-token>
BRIDGE_CALLBACK_SUCCESS_STATUSES=completed
BRIDGE_MAX_INCOMING_BODY_BYTES=2097152
BRIDGE_CALLBACK_RESERVATION_TIMEOUT_SECONDS=120
BRIDGE_HEALTH_PROBE_TIMEOUT_SECONDS=5

# Kaiten. The API version is pinned deliberately; do not replace /api/v1 with /api/latest.
BRIDGE_KAITEN_BASE_URL=https://tagat.kaiten.ru/api/v1
BRIDGE_KAITEN_TOKEN=<replace-with-kaiten-api-token>
BRIDGE_KAITEN_SPACE_ID=834556
BRIDGE_KAITEN_SPACE_NAME=ИИ
BRIDGE_KAITEN_BOARD_ID=1868751
BRIDGE_KAITEN_BOARD_NAME=Доска агента
BRIDGE_KAITEN_QUEUE_COLUMN_ID=6467479
BRIDGE_KAITEN_QUEUE_COLUMN_NAME=Очередь
BRIDGE_KAITEN_WORK_COLUMN_ID=6467480
BRIDGE_KAITEN_WORK_COLUMN_NAME=В работе
BRIDGE_KAITEN_DONE_COLUMN_ID=6467481
BRIDGE_KAITEN_DONE_COLUMN_NAME=Готово
BRIDGE_KAITEN_SERVICE_ID=9162
BRIDGE_KAITEN_SERVICE_NAME=ИИ
BRIDGE_KAITEN_REQUEST_TYPE_FIELD=Тип заявки
# Confirmed by the read-only tenant probe on 2026-09-01; may be removed to resolve by name.
BRIDGE_KAITEN_REQUEST_TYPE_FIELD_ID=626883
# Comma-separated bot/corporate-AI author IDs whose comments must be ignored.
BRIDGE_KAITEN_TECHNICAL_AUTHOR_IDS=
BRIDGE_KAITEN_TIMEOUT_SECONDS=30
BRIDGE_KAITEN_REQUESTS_PER_SECOND=45

# Corporate AI receiver. These values are provisional until the HTTP contract is signed off.
BRIDGE_AI_SCHEME=http
BRIDGE_AI_HOST=127.0.0.1
BRIDGE_AI_PORT=8090
BRIDGE_AI_PATH=/api/v1/jobs
BRIDGE_AI_BEARER_TOKEN=<replace-with-corporate-ai-receiver-token>
BRIDGE_AI_CONNECT_TIMEOUT_SECONDS=5
BRIDGE_AI_READ_TIMEOUT_SECONDS=60

# Transport contract and file policy
BRIDGE_SCHEMA_VERSION=1
BRIDGE_MAX_FILE_BYTES=5242880
BRIDGE_ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.csv,.txt,.md,.sql,.json,.xml,.ppt,.pptx,.png,.jpg,.jpeg,.tif,.tiff
# Required for production after the receiver/proxy body limit is agreed, including Base64 overhead.
# The service intentionally refuses to start with BRIDGE_ENVIRONMENT=production until this is set.
# BRIDGE_MAX_OUTGOING_BODY_BYTES=10485760

# Queue, retries, reconciliation, retention, and concurrency
BRIDGE_RETRY_SCHEDULE_SECONDS=0,2,5,10,20,40,80,150,300
BRIDGE_RECONCILIATION_INTERVAL_SECONDS=21600
BRIDGE_CLEANUP_INTERVAL_SECONDS=86400
BRIDGE_ACTIVITY_RETENTION_DAYS=30
BRIDGE_WARNING_BEFORE_CLOSE_HOURS=24
BRIDGE_DEDUP_RETENTION_DAYS=3
BRIDGE_LOG_RETENTION_DAYS=3
BRIDGE_TEMP_RETENTION_DAYS=3
BRIDGE_CARD_PARALLELISM=4
BRIDGE_WORKER_POLL_SECONDS=0.5
BRIDGE_RECONCILE_ON_STARTUP=true
BRIDGE_CLEANUP_ON_STARTUP=true
